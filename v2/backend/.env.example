APP_NAME="Trabalho Amigo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trabalhoamigo
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Cache / Session ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=600
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=43200

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_ONBOARDING_RETURN_URL=http://localhost:3000/dashboard/stripe/return
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:3000/dashboard/stripe/refresh

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@trabalhoamigo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
